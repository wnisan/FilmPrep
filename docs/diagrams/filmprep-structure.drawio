<diagram id="structure" name="Структурная схема приложения"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="structure-v1" value="Браузер пользователя — клиент React SPA (Vite)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fillColor=#f5faff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="330" height="1040" as="geometry"/></mxCell><mxCell id="structure-v2" value="&lt;b&gt;Страницы (react-router)&lt;/b&gt;&lt;br&gt;LandingPage, LoginPage, RegisterPage, GoogleAuthCallbackPage, CatalogPage, MediaDetailPage (плеер, словарь фильма, грамматика, тренировки, чат), QuizPage, MyFilmsPage, MyFilmEditorPage, DictionaryPage, ProgressPage, ProfilePage, ProfileSettingsPage, CommunityPage, AdminMediaPage" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="290" height="200" as="geometry"/></mxCell><mxCell id="structure-v3" value="&lt;b&gt;Компоненты&lt;/b&gt;&lt;br&gt;AppShell, RequireAuth, FilmPlayer, SubtitleWordPopup, PronounceButtons, FilmChat, Practice, GrammarQuiz, PrepSteps, CommentsSection, StarRating, DailyGoal, Dropdown, LanguageSwitcher, YandexDiskImport, FilmStrip" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="290" height="170" as="geometry"/></mxCell><mxCell id="structure-v4" value="&lt;b&gt;Состояние (zustand)&lt;/b&gt;&lt;br&gt;authStore — пользователь и токен доступа&lt;br&gt;goalStore — цель дня" style