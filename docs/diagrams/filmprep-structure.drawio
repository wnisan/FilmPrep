ll><mxCell id="structure-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="structure-v3" target="structure-v6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="415"/><mxPoint x="340" y="780"/></Array></mxGeometry></mxCell><mxCell id="structure-v11" value="Docker Compose (проект filmprep)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fillColor=none;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="1110" height="1080" as="geometry"/></mxCell><mxCell id="structure-v12" value="&lt;b&gt;filmprep-web: Nginx (порт 8080)&lt;/b&gt;&lt;br&gt;Раздача собранного клиента (client/dist)&lt;br&gt;proxy_pass /api/v1, /uploads → api:4000" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="440" y="100" width="360" height="90" as="geometry"/></mxCell><mxCell id="structure-v13" value="filmprep-api: Node.js 20 + Express (порт 4000)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;fillColor=#fffaf3;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="790" height="860" as="geometry"/></mxCell><mxCell id="structure-v14" value="&lt;b&gt;Промежуточное ПО (middleware)&lt;/b&gt;&lt;br&gt;JWT-аутентификация, проверка ролей (learner / admin), multer — загрузка файлов, валидация zod, обработка ошибок" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="460" y="280" width="470" height="70" as="geometry"/></mxCell><mxCel