ON DELETE SET NULL)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1600" y="820" width="360" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram>
