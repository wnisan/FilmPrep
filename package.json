{
  "name": "filmprep",
  "version": "0.1.0",
  "private": true,
  "description": "FilmPrep — language prep for watching movies in the original",
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "install:all": "npm --prefix client install && npm --prefix server install",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:migrate": "npm --prefix server run migrate",
    "db:seed": "npm --prefix server run seed"
  },
  "engines": {
    "node": ">=20"
  }
}
