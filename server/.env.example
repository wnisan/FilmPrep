PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://filmprep:filmprep@localhost:5433/filmprep

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

UPLOAD_DIR=uploads
# Флаг Secure у кук: по умолчанию true при NODE_ENV=production (нужен HTTPS)
# COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:5173

# Google Sign-In (см. docs/AUTH-GOOGLE.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# Optional LLM enrichment via LiteRouter / Groq / OpenRouter (OpenAI-compatible)
LLM_ENABLED=false
LLM_PROVIDER=literouter
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b:free
LLM_BASE_URL=https://api.literouter.com/v1
LLM_LEXICON_LIMIT=25
LLM_PHRASE_LIMIT=20
LLM_MIN_INTERVAL_MS=7500

# Яндекс Диск (см. docs/YANDEX-DISK.md): хранение видео + импорт фильмов с Диска
YADISK_TOKEN=
YADISK_ROOT=disk:/FilmPrep
# STORAGE_DRIVER=local   # хранить видео локально, а с Диска только импортировать

# Video storage (см. docs/VIDEO-STORAGE.md). Пусто → локальная папка uploads/storage
# Backblaze B2 (бесплатно 10 ГБ, без карты):
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_LABEL=Backblaze B2
# proxy — сегменты идут через API (приватный бакет, без CORS); signed — напрямую из бакета
STREAM_SEGMENTS=proxy

# HLS: какие качества нарезать (1080,720,480,360) и скорость ffmpeg
HLS_VARIANTS=720,360
HLS_PRESET=veryfast
VIDEO_MAX_UPLOAD_MB=8192
